# Sugar City API — copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=5050
NODE_ENV=development

# --- Database (required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/sugarcity

# --- Auth (JWT_SECRET required: a long random string) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Front ends (required; comma-separated lists allowed) ---
# Used for CORS. ADMIN_URL (the first one, if several) is also used for links in emails.
CLIENT_URL=http://localhost:5180
ADMIN_URL=http://localhost:5181

# --- Email via Resend (optional; email is off when RESEND_API_KEY is blank) ---
RESEND_API_KEY=
MAIL_FROM=Sugar City <onboarding@resend.dev>
ORDER_EMAIL_TO=

# --- Cloudinary for menu photos (optional; uploads fail until set) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- First admin account, used by `npm run seed` only ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
